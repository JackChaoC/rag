# Copy to .env.llama-index. Old .env and unprefixed variables are NOT loaded.
RAG_LI_DATABASE_URL=postgresql://rag:rag@127.0.0.1:5432/rag_llama_index
RAG_LI_RABBITMQ_URL=amqp://rag:rag@127.0.0.1:5672/
RAG_LI_QDRANT_URL=http://127.0.0.1:6333
RAG_LI_OLLAMA_URL=http://127.0.0.1:11434
RAG_LI_EMBEDDING_MODEL=qwen3-embedding:8b
RAG_LI_OLLAMA_NUM_GPU=0
RAG_LI_QDRANT_COLLECTION=rag_llama_index_nodes
RAG_LI_STORAGE_PATH=statics
RAG_LI_RABBITMQ_NAMESPACE=rag.llama-index.indexing
RAG_LI_RABBITMQ_PREFETCH=4
RAG_LI_RABBITMQ_RETRY_DELAYS=1,5,30
